    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "27.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "5.1.4",
